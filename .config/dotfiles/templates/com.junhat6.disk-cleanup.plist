<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>com.junhat6.disk-cleanup</string>
    <key>ProgramArguments</key><array>
        <string>/bin/bash</string><string>@HOME@/.config/dotfiles/scripts/disk-cleanup.sh</string>
    </array>
    <key>StartCalendarInterval</key><dict>
        <key>Weekday</key><integer>0</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer>
    </dict>
    <key>ProcessType</key><string>Background</string>
    <key>LowPriorityIO</key><true/>
    <key>StandardOutPath</key><string>@HOME@/.claude/logs/disk-cleanup.log</string>
    <key>StandardErrorPath</key><string>@HOME@/.claude/logs/disk-cleanup.log</string>
</dict></plist>
