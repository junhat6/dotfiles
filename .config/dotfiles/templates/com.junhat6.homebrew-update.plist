<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>com.junhat6.homebrew-update</string>
    <key>ProgramArguments</key><array>
        <string>/bin/bash</string><string>@HOME@/.config/dotfiles/scripts/homebrew-update.sh</string>
    </array>
    <key>StartCalendarInterval</key><dict>
        <key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer>
    </dict>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>@HOME@/.claude/logs/homebrew-update.log</string>
    <key>StandardErrorPath</key><string>@HOME@/.claude/logs/homebrew-update.log</string>
</dict></plist>
